  <diagram name="14_asistencia" id="STQAPs_ci3dNpnlKgqQV">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="SNChAUwbsb5NBZyxn3wf-0" />
        <mxCell id="SNChAUwbsb5NBZyxn3wf-1" parent="SNChAUwbsb5NBZyxn3wf-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Registro y clasificación de asistencia\\nRF-6.2, RF-7.1 a RF-7.3; regla RNF-6.2\nhide footbox\nautonumber\nskinparam maxMessageSize 55\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam sequence {\n ParticipantBackgroundColor white\n ParticipantBorderColor #555555\n ParticipantFontColor black\n LifeLineBorderColor #777777\n ArrowColor #444444\n ArrowFontColor black\n GroupBackgroundColor white\n GroupBorderColor #777777\n}\nparticipant \&quot;Aprendiz / punto de registro\&quot; as U\nparticipant \&quot;Interfaz del sistema\&quot; as UI\nparticipant \&quot;Lógica / controlador\&quot; as C\nparticipant \&quot;Base de datos / repositorio\&quot; as DB\n\nU -&gt; UI : Presentar rostro durante sesión configurada\nUI -&gt; C : Enviar evento de reconocimiento y contexto\nC -&gt; DB : Consultar sesión, parámetros vigentes y horario/excepción\nDB --&gt; C : Contexto aplicable\nC -&gt; C : Validar reconocimiento y correspondencia con sesión\nalt Evento válido\n  alt Entrada dentro de ventana puntual\n    C -&gt; DB : Registrar entrada como puntual con hora y contexto\n    DB --&gt; C : Resultado de registro\n    C --&gt; UI : Comunicar resultado real de asistencia\n  else Entrada después de ventana puntual y antes de salida\n    C -&gt; DB : Registrar entrada como retardo con hora y contexto\n    DB --&gt; C : Resultado de registro\n    C --&gt; UI : Comunicar resultado real de asistencia\n  else Evento durante ventana de salida de aprendiz con entrada\n    C -&gt; DB : Registrar evidencia de salida conservando clasificación de entrada\n    DB --&gt; C : Resultado de registro\n    C --&gt; UI : Comunicar resultado de evidencia de salida\n  else Punto cerrado o evento fuera de condiciones aprobadas\n    C --&gt; UI : No registrar asistencia fuera de reglas\n  end\n  UI --&gt; U : Mostrar resultado\nelse Rostro no válido o sesión no correspondiente\n  C --&gt; UI : Rechazar evento sin entrada válida\n  UI --&gt; U : Informar motivo\nend\nopt Evaluación de ausencia en corte aprobado\n  C -&gt; DB : Consultar aprendices sin entrada válida en sesión\n  DB --&gt; C : Aprendices sin entrada\n  C -&gt; DB : Registrar ausencia según regla aprobada\n  DB --&gt; C : Resultado de clasificación\nend\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mne4miRstiCbZylsTM_L-0">
          <mxCell connectable="0" parent="SNChAUwbsb5NBZyxn3wf-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
