        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Registro facial inicial autorizado\\nRF-5.1\nhide footbox\nautonumber\nskinparam maxMessageSize 55\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam sequence {\n ParticipantBackgroundColor white\n ParticipantBorderColor #555555\n ParticipantFontColor black\n LifeLineBorderColor #777777\n ArrowColor #444444\n ArrowFontColor black\n GroupBorder GroupBackgroundColor white\nColor #777777\n}\nparticipant \&quot;Aprendiz\&quot; as U\nparticipant \&quot;Interfaz del sistema\&quot; as UI\nparticipant \&quot;Lógica / controlador\&quot; as C\nparticipant \&quot;Base de datos / repositorio\&quot; as DB\n\nU -&gt; UI : Iniciar enrolamiento autorizado\nUI -&gt; C : Verificar autorización e identidad\nC --&gt; UI : Resultado de habilitación\nalt Identidad y autorización válidas\n  UI --&gt; U : Solicitar captura de muestras requeridas\n  U -&gt; UI : Proporcionar captura\n  UI -&gt; C : Enviar captura para procesamiento\n  C -&gt; C : Validar captura y muestras según versión aprobada\n  alt Captura válida y procesamiento disponible\n    C -&gt; DB : Asociar resultado facial al aprendiz\n    DB --&gt; C : Resultado de asociación\n    C --&gt; UI : Comunicar resultado real\n    UI --&gt; U : Mostrar registro completado o fallo\n  else Captura inválida, muestras insuficientes o servicio no disponible\n    C --&gt; UI : Detener enrolamiento y permitir reintento seguro\n    UI --&gt; U : Mostrar causa\n  end\nelse Identidad no verificada o falta autorización\n  C --&gt; UI : Impedir enrolamiento\n  UI --&gt; U : Informar falta de habilitación\nend\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RDrYmUvswaTVbD7LWhz1-0">
