        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Consulta de asistencia por ficha, usuario e historial\\nRF-7.1, RF-7.2, RF-7.3\nhide footbox\nautonumber\nskinparam maxMessageSize 55\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam sequence {\n ParticipantBackgroundColor white\n ParticipantBorderColor #555555\n ParticipantFontColor black\n LifeLineBorderColor #777777\n ArrowColor #444444\n ArrowFontColor black\n GroupBackgroundColor white\n GroupBorderColor #777777\n}\nparticipant \&quot;Usuario autorizado\&quot; as U\nparticipant \&quot;Interfaz del sistema\&quot; as UI\nparticipant \&quot;Lógica / controlador\&quot; as C\nparticipant \&quot;Base de datos / repositorio\&quot; as DB\n\nU -&gt; UI : Elegir vista y filtros permitidos\nUI -&gt; C : Consultar asistencia por programa/ficha, usuario o historial\nC -&gt; C : Validar sesión, alcance y rango de fechas\nalt Filtros y alcance válidos\n  C -&gt; DB : Consultar registros permitidos y contexto\n  DB --&gt; C : Registros disponibles o sin registros\n  alt Existen registros\n    C -&gt; C : Preparar tarjetas, tabla o historial según vista\n    C --&gt; UI : Devolver asistencia y detalle autorizado\n    UI --&gt; U : Mostrar resultados con estados\n    opt Usuario abre detalle de un registro permitido\n      U -&gt; UI : Seleccionar día/registro\n      UI -&gt; C : Solicitar detalle\n      C -&gt; C : Revalidar alcance del registro\n      C -&gt; DB : Consultar hora, ambiente e instructor del registro\n      DB --&gt; C : Detalle permitido\n      C --&gt; UI : Devolver detalle\n      UI --&gt; U : Mostrar información del día\n    end\n  else Sin registros\n    C --&gt; UI : Devolver estado vacío\n    UI --&gt; U : Mostrar que no existen registros\n  end\nelse Rango inválido o entidad ajena\n  C --&gt; UI : Rechazar consulta sin revelar datos ajenos\n  UI --&gt; U : Mostrar causa\nend\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0Kiki1hL2uJdXD-yf_E0-0">
