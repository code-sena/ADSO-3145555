        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Reportes y exportación por rol\\nRF-9.1\nhide footbox\nautonumber\nskinparam maxMessageSize 55\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam sequence {\n ParticipantBackgroundColor white\n ParticipantBorderColor #555555\n ParticipantFontColor black\n LifeLineBorderColor #777777\n ArrowColor #444444\n ArrowFontColor black\n GroupBackgroundColor white\n GroupBorderColor #777777\n}\nparticipant \&quot;Usuario autorizado\&quot; as U\nparticipant \&quot;Interfaz del sistema\&quot; as UI\nparticipant \&quot;Lógica / controlador\&quot; as C\nparticipant \&quot;Base de datos / repositorio\&quot; as DB\n\nU -&gt; UI : Abrir reporte y seleccionar período/filtros\nUI -&gt; C : Solicitar reporte\nC -&gt; C : Validar sesión, filtros y alcance por rol\nalt Consulta autorizada\n  C -&gt; DB : Consultar asistencia limitada al alcance permitido\n  DB --&gt; C : Datos suficientes, insuficientes o fuente no disponible\n  alt Datos suficientes\n    C -&gt; C : Calcular indicadores con fórmulas aprobadas\n    C --&gt; UI : Devolver reporte autorizado\n    UI --&gt; U : Mostrar indicadores\n    opt Exportación habilitada y solicitada\n      U -&gt; UI : Solicitar exportación\n      UI -&gt; C : Exportar mismos filtros y alcance\n      C -&gt; C : Revalidar permiso y generar archivo permitido\n      C -&gt; DB : Registrar trazabilidad de exportación\n      DB --&gt; C : Registro confirmado\n      C --&gt; UI : Entregar archivo del alcance autorizado\n      UI --&gt; U : Ofrecer descarga\n    end\n  else Datos insuficientes o fuente no disponible\n    C --&gt; UI : Estado vacío o error de fuente sin porcentajes engañosos\n    UI --&gt; U : Mostrar respuesta\n  end\nelse Filtros inválidos o fuera de alcance\n  C --&gt; UI : Denegar sin revelar datos ajenos\n  UI --&gt; U : Mostrar rechazo\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9FANi-8wstHGONHbToL8-0">
