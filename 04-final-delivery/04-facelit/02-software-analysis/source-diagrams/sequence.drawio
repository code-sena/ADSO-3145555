        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Envío de notificaciones por correo\\nRF-8.3\nhide footbox\nautonumber\nskinparam maxMessageSize 55\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam sequence {\n ParticipantBackgroundColor white\n ParticipantBorderColor #555555\n ParticipantFontColor black\n LifeLineBorderColor #777777\n ArrowColor #444444\n ArrowFontColor black\n GroupBackgroundColor white\n GroupBorderColor #777777\n}\nparticipant \&quot;Servicio de notificaciones\&quot; as U\nparticipant \&quot;Cola de correo\&quot; as UI\nparticipant \&quot;Dispatcher de correo\&quot; as C\nparticipant \&quot;Bitácora\&quot; as DB\nparticipant \&quot;Servidor SMTP\&quot; as X\n\nU -&gt; UI : Encolar notificación con canal App + Correo\nUI -&gt; C : Solicitar procesamiento del correo\nC -&gt; C : Preparar asunto y cuerpo sin credenciales ni biometría\nC -&gt; X : Intentar envío por SMTP\nX --&gt; C : Resultado del envío\nalt Envío exitoso\n  C -&gt; DB : Registrar envío asociado a notificación\n  DB --&gt; C : Bitácora actualizada\n  C --&gt; UI : Marcar envío exitoso\nelse Fallo SMTP\n  loop Hasta 3 reintentos, solo mientras falle\n    C -&gt; X : Reintentar envío\n    X --&gt; C : Resultado del reintento\n    C -&gt; DB : Registrar resultado del intento\n    DB --&gt; C : Registro confirmado\n  end\n  alt Un reintento tuvo éxito\n    C --&gt; UI : Marcar envío exitoso\n  else Fallan todos los reintentos\n    C -&gt; DB : Registrar pendiente de envío\n    DB --&gt; C : Estado registrado\n    C --&gt; UI : Conservar pendiente sin perder notificación en app\n  end\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GizQBwlr90XwMYFmidrP-0">
