  <diagram name="02_recuperacion" id="bdGQrCDe4QU2fCHLPKOd">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="NiUm48QlMDRziwNxTnI--0" />
        <mxCell id="NiUm48QlMDRziwNxTnI--1" parent="NiUm48QlMDRziwNxTnI--0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Restablecimiento de contraseña\\nRF-1.4\nhide footbox\nautonumber\nskinparam maxMessageSize 55\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam sequence {\n ParticipantBackgroundColor white\n ParticipantBorderColor #555555\n ParticipantFontColor black\n LifeLineBorderColor #777777\n ArrowColor #444444\n ArrowFontColor black\n GroupBackgroundColor white\n GroupBorderColor #777777\n}\nparticipant \&quot;Usuario\&quot; as U\nparticipant \&quot;Interfaz del sistema\&quot; as UI\nparticipant \&quot;Lógica / controlador\&quot; as C\nparticipant \&quot;Base de datos / repositorio\&quot; as DB\nparticipant \&quot;Servicio de correo\&quot; as X\n\nU -&gt; UI : Solicitar recuperación con correo registrado\nUI -&gt; C : Validar solicitud\nC -&gt; DB : Buscar cuenta asociada al correo\nDB --&gt; C : Resultado de búsqueda\nalt Cuenta recuperable\n  C -&gt; C : Generar código de un solo uso con vencimiento máximo de 5 minutos\n  C -&gt; DB : Registrar código y vencimiento\n  DB --&gt; C : Registro confirmado\n  C -&gt; X : Solicitar envío del código\n  X --&gt; C : Resultado del envío\n  alt Envío disponible\n    C --&gt; UI : Solicitar código de verificación\n    UI --&gt; U : Mostrar formulario de código\n    U -&gt; UI : Ingresar código\n    UI -&gt; C : Verificar código\n    C -&gt; DB : Consultar vigencia y uso\n    DB --&gt; C : Estado del código\n    alt Código correcto, vigente y no utilizado\n      C --&gt; UI : Habilitar nueva contraseña\n      UI --&gt; U : Solicitar contraseña y confirmación\n      U -&gt; UI : Enviar nueva contraseña y confirmación\n      UI -&gt; C : Solicitar cambio\n      C -&gt; C : Validar política, coincidencia y vigencia del código\n      alt Datos válidos\n        C -&gt; DB : Actualizar hash, fecha de cambio e invalidar código\n        DB --&gt; C : Cambio confirmado\n        C --&gt; UI : Confirmar restablecimiento\n        UI --&gt; U : Informar cambio completado\n      else Política incumplida, falta coincidencia o código vencido\n        C --&gt; UI : Rechazar cambio y conservar contraseña\n        UI --&gt; U : Mostrar causa y permitir corrección autorizada\n      end\n    else Código incorrecto, vencido o usado\n      C --&gt; UI : Rechazar código\n      UI --&gt; U : Informar y permitir solicitar nuevo código\n    end\n  else Fallo de correo\n    C --&gt; UI : Informar que no se pudo continuar\n    UI --&gt; U : Mostrar fallo de entrega\n  end\nelse Correo no disponible para recuperación\n  C --&gt; UI : Respuesta sin revelar información sensible\n  UI --&gt; U : Mostrar respuesta de recuperación\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="IqIyLjifrc812fxXxVXs-0">
          <mxCell connectable="0" parent="NiUm48QlMDRziwNxTnI--1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
