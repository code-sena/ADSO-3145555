        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Traslado de ficha\\nRF-2.3\nhide footbox\nautonumber\nskinparam maxMessageSize 55\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam sequence {\n ParticipantBackgroundColor white\n ParticipantBorderColor #555555\n ParticipantFontColor black\n LifeLineBorderColor #777777\n ArrowColor #444444\n ArrowFontColor black\n GroupBackgroundColor white\n GroupBorderColor #777777\n}\nparticipant \&quot;Coordinador\&quot; as U\nparticipant \&quot;Interfaz del sistema\&quot; as UI\nparticipant \&quot;Lógica / controlador\&quot; as C\nparticipant \&quot;Base de datos / repositorio\&quot; as DB\n\nU -&gt; UI : Buscar aprendiz y abrir traslado\nUI -&gt; C : Solicitar fichas destino permitidas\nC -&gt; DB : Consultar aprendiz, ficha actual y fichas activas distintas\nDB --&gt; C : Aprendiz, origen y destinos\nC --&gt; UI : Mostrar fichas disponibles\nUI --&gt; U : Solicitar destino y confirmación\nU -&gt; UI : Confirmar ficha destino\nUI -&gt; C : Solicitar traslado\nC -&gt; C : Validar rol, aprendiz y destino activo distinto\nalt Traslado válido\n  group Operación atómica\n    C -&gt; DB : Desactivar vínculo origen y activar vínculo destino en una operación\n    DB --&gt; C : Confirmación completa o fallo sin cambio parcial\n  end\n  alt Traslado confirmado\n    C -&gt; DB : Registrar trazabilidad y notificación de confirmación\n    DB --&gt; C : Registro confirmado\n    C --&gt; UI : Informar nueva ficha activa\n    UI --&gt; U : Mostrar traslado completado\n  else Fallo del traslado\n    C --&gt; UI : Conservar ficha origen e informar fallo\n    UI --&gt; U : Mostrar que el traslado no se completó\n  end\nelse Destino inválido o falta autorización\n  C --&gt; UI : Rechazar sin cambiar vínculo\n  UI --&gt; U : Mostrar causa\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9ZrR-AkTTTYBu_1pEIDO-0">
