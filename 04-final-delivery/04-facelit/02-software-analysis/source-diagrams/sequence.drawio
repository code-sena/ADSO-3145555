  <diagram name="13_solicitud_facial" id="3H55Qta_BxY-zG7n3xUj">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="fdSXrOveWFlFrABvOiSm-0" />
        <mxCell id="fdSXrOveWFlFrABvOiSm-1" parent="fdSXrOveWFlFrABvOiSm-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Solicitud y autorización de nuevo registro facial\\nRF-5.4, RF-8.4\nhide footbox\nautonumber\nskinparam maxMessageSize 55\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam sequence {\n ParticipantBackgroundColor white\n ParticipantBorderColor #555555\n ParticipantFontColor black\n LifeLineBorderColor #777777\n ArrowColor #444444\n ArrowFontColor black\n GroupBackgroundColor white\n GroupBorderColor #777777\n}\nparticipant \&quot;Aprendiz / Coordinador\&quot; as U\nparticipant \&quot;Interfaz del sistema\&quot; as UI\nparticipant \&quot;Lógica / controlador\&quot; as C\nparticipant \&quot;Base de datos / repositorio\&quot; as DB\n\nU -&gt; UI : Aprendiz solicita registrar rostro nuevamente\nUI -&gt; C : Crear solicitud del usuario autenticado\nC -&gt; DB : Verificar registro previo y solicitud pendiente\nDB --&gt; C : Registro y solicitud existente o inexistente\nalt Solicitud nueva permitida\n  C -&gt; DB : Crear solicitud pendiente y notificación al Coordinador\n  DB --&gt; C : Creación confirmada\n  C --&gt; UI : Confirmar solicitud; cámara sigue deshabilitada\n  UI --&gt; U : Mostrar solicitud pendiente\nelse Solicitud duplicada o no permitida\n  C --&gt; UI : Rechazar sin duplicar solicitud\n  UI --&gt; U : Mostrar causa\nend\nU -&gt; UI : Coordinador abre notificación y acepta/rechaza\nUI -&gt; C : Resolver solicitud\nC -&gt; DB : Consultar estado y alcance de solicitud\nDB --&gt; C : Solicitud y estado\nC -&gt; C : Validar permiso y que siga pendiente\nalt Resolución permitida\n  alt Aceptar\n    C -&gt; DB : Guardar decisión y autorización de un solo uso\n    DB --&gt; C : Decisión confirmada\n    C --&gt; UI : Habilitar nuevo registro facial del aprendiz autorizado\n  else Rechazar\n    C -&gt; DB : Guardar rechazo sin alterar registro facial\n    DB --&gt; C : Decisión confirmada\n    C --&gt; UI : Conservar registro y permitir nueva solicitud\n  end\n  C -&gt; DB : Registrar comunicación de decisión o fallo/reintento\n  DB --&gt; C : Estado de comunicación registrado\n  UI --&gt; U : Mostrar decisión según destinatario\nelse Ya resuelta o actor sin permiso\n  C --&gt; UI : Rechazar segunda resolución o acceso no autorizado\n  UI --&gt; U : Informar causa\nend\nopt Nuevo registro completado bajo autorización aceptada\n  UI -&gt; C : Confirmar finalización del re-registro\n  C -&gt; DB : Consumir autorización del aprendiz\n  DB --&gt; C : Consumo confirmado\n  C --&gt; UI : Impedir reutilización\nend\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="HtyDDRxF-2n8AgK_d9ow-0">
          <mxCell connectable="0" parent="fdSXrOveWFlFrABvOiSm-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
