        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Preferencias personales\\nRF-4.2\nhide footbox\nautonumber\nskinparam maxMessageSize 55\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam sequence {\n ParticipantBackgroundColor white\n ParticipantBorderColor #555555\n ParticipantFontColor black\n LifeLineBorderColor #777777\n ArrowColor #444444\n ArrowFontColor black\n GroupBackgroundColor white\n GroupBorderColor #777777\n}\nparticipant \&quot;Usuario autenticado\&quot; as U\nparticipant \&quot;Interfaz del sistema\&quot; as UI\nparticipant \&quot;Lógica / controlador\&quot; as C\nparticipant \&quot;Base de datos / repositorio\&quot; as DB\n\nU -&gt; UI : Abrir preferencias y elegir tema/idioma\nUI --&gt; U : Aplicar vista previa local\nU -&gt; UI : Guardar cambios\nUI -&gt; C : Solicitar guardar preferencias propias\nC -&gt; C : Validar sesión y opciones soportadas\nalt Opciones válidas y sesión propia\n  C -&gt; DB : Persistir preferencias del usuario autenticado\n  DB --&gt; C : Resultado de guardado\n  alt Guardado confirmado\n    C --&gt; UI : Confirmar persistencia\n    UI --&gt; U : Mantener preferencia aplicada y mostrar éxito\n  else Fallo de persistencia\n    C --&gt; UI : Informar fallo\n    UI --&gt; U : Conservar/restaurar valor anterior y mostrar error\n  end\nelse Valor no soportado o falta autorización\n  C --&gt; UI : Rechazar cambio\n  UI --&gt; U : Mostrar opciones válidas y conservar anterior\nend\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fDfxfK6oJcGo2xpr5Yf--1">
