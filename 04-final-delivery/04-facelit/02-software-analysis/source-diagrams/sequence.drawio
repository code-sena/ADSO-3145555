        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Gestión manual de entidades académicas\\nRF-2.2\nhide footbox\nautonumber\nskinparam maxMessageSize 55\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam sequence {\n ParticipantBackgroundColor white\n ParticipantBorderColor #555555\n ParticipantFontColor black\n LifeLineBorderColor #777777\n ArrowColor #444444\n ArrowFontColor black\n GroupBackgroundColor white\n GroupBorderColor #777777\n}\nparticipant \&quot;Coordinador\&quot; as U\nparticipant \&quot;Interfaz del sistema\&quot; as UI\nparticipant \&quot;Lógica / controlador\&quot; as C\nparticipant \&quot;Base de datos / repositorio\&quot; as DB\n\nU -&gt; UI : Seleccionar entidad y operación\nUI -&gt; C : Enviar operación, datos y confirmación\nC -&gt; C : Validar permiso y campos\nalt Datos inválidos o falta autorización\n  C --&gt; UI : Rechazar operación sin confirmar cambios\n  UI --&gt; U : Indicar causa\nelse Operación autorizada\n  alt Crear\n    C -&gt; C : Generar credencial si es aprendiz o instructor nuevo\n    C -&gt; DB : Crear entidad activa con fecha y responsable\n    DB --&gt; C : Resultado de creación\n  else Editar\n    C -&gt; DB : Actualizar datos válidos y fecha de modificación\n    DB --&gt; C : Resultado de edición\n  else Desactivar o reactivar\n    C -&gt; DB : Actualizar estado y fecha; conservar relaciones históricas\n    DB --&gt; C : Resultado de cambio\n  else Eliminar permanentemente\n    C -&gt; DB : Consultar estado y dependencias\n    DB --&gt; C : Estado y relaciones existentes\n    alt Entidad inactiva y sin dependencias\n      C -&gt; DB : Eliminar entidad y registrar operación\n      DB --&gt; C : Resultado de eliminación\n    else Entidad activa o con dependencias\n      C --&gt; UI : Rechazar e indicar relación que lo impide\n    end\n  end\n  C --&gt; UI : Comunicar resultado real de operación\n  UI --&gt; U : Mostrar confirmación o causa del rechazo/fallo\nend\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GYjqjUJKJ6h9mHx89Mm3-0">
