        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n title RF-1.1 — Inicio de sesión\n caption Flujo objetivo del SRS V3 | Estado: PARCIAL\n skinparam shadowing false\n skinparam defaultFontName SansSerif\n skinparam defaultFontSize 13\n skinparam activityBackgroundColor #F4F7FB\n skinparam activityBorderColor #334155\n skinparam activityDiamondBackgroundColor #FFF4CE\n skinparam activityDiamondBorderColor #334155\n skinparam ArrowColor #334155\n skinparam swimlaneBorderColor #64748B\n|Usuario|\nstart\n:Acceder a inicio de sesión;\n|Sistema|\n:Mostrar formulario de documento\ny contraseña;\n|Usuario|\n:Ingresar documento y contraseña;\n|Sistema|\nif (¿Servidor disponible?) then (Sí)\n :Validar campos y formato;\nelse (No)\n :Informar indisponibilidad;\n stop\nendif\nif (¿Campos válidos?) then (Sí)\n |Base de datos|\n :Consultar cuenta por documento,\nhash, estado y aceptación de privacidad;\n |Sistema|\n :Comparar contraseña con hash;\nelse (No)\n :Señalar campos y permitir reintento;\n stop\nendif\nif (¿Credenciales válidas y cuenta activa?) then (Sí)\n if (¿Privacidad aceptada previamente?) then (No)\n  :Mostrar aviso de privacidad;\n  |Usuario|\n  :Leer y decidir aceptación;\n  |Sistema|\n  if (¿Acepta?) then (Sí)\n   |Base de datos|\n   :Registrar aceptación;\n  else (No)\n   |Sistema|\n   :No habilitar acceso;\n   stop\n  endif\n endif\n |Sistema|\n :Determinar rol según RF-1.3;\n if (¿Rol reconocido?) then (Sí)\n  :Generar sesión y permisos;\n  |Base de datos|\n  :Auditar intento exitoso;\n  |Sistema|\n  :Mostrar panel correspondiente al rol;\n else (No)\n  :Denegar área protegida\ny registrar error de rol;\n endif\nelse (No)\n |Base de datos|\n :Auditar intento fallido;\n |Sistema|\n :Denegar acceso y permitir reintento\nsegún política de bloqueo;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PPQTTjJSOFHb_lV6WVdN-1">
