  <diagram id="UmCoYFePnmNK-r_3nVFA" name="RF-2.2 — Gestión académica manual">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle RF-2.2 — Gestión académica manual\ncaption Flujo objetivo del SRS V3 | Estado: POR VERIFICAR\n\nskinparam shadowing false\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 13\nskinparam activityBackgroundColor #F4F7FB\nskinparam activityBorderColor #334155\nskinparam activityDiamondBackgroundColor #FFF4CE\nskinparam activityDiamondBorderColor #334155\nskinparam ArrowColor #334155\nskinparam swimlaneBorderColor #64748B\n\n|Coordinador|\nstart\n:Abrir Gestión académica;\n\n|Sistema|\n:Validar sesión y permiso de Coordinador;\n\nif (¿Está autorizado?) then (Sí)\n  :Mostrar entidades y acciones disponibles;\nelse (No)\n  :Denegar operación;\n  stop\nendif\n\n|Coordinador|\n:Seleccionar Programa, Ficha,\\nAprendiz o Instructor;\n:Elegir la acción;\n\n|Sistema|\nswitch (Acción seleccionada)\n\ncase (Crear)\n  |Coordinador|\n  :Completar datos de la nueva entidad;\n\n  |Sistema|\n  :Validar campos, unicidad y relaciones;\n\n  if (¿Datos válidos?) then (Sí)\n    if (¿Es Aprendiz o Instructor?) then (Sí)\n      :Preparar credencial segura\\nsegún RF-3.4;\n    endif\n    :Preparar creación en estado activo;\n  else (No)\n    :Mostrar errores sin guardar;\n    stop\n  endif\n\ncase (Editar)\n  |Base de datos|\n  :Consultar entidad y datos actuales;\n\n  |Coordinador|\n  :Modificar campos permitidos;\n\n  |Sistema|\n  :Validar datos y relaciones;\n\n  if (¿Cambios válidos?) then (Sí)\n    :Preparar actualización;\n  else (No)\n    :Mostrar errores sin guardar;\n    stop\n  endif\n\ncase (Desactivar)\n  |Base de datos|\n  :Consultar estado actual;\n\n  |Sistema|\n  if (¿La entidad está activa?) then (Sí)\n    :Preparar cambio a estado inactivo;\n    :Conservar relaciones e historial;\n  else (No)\n    :Informar que ya está inactiva;\n    stop\n  endif\n\ncase (Reactivar)\n  |Base de datos|\n  :Consultar estado y relaciones;\n\n  |Sistema|\n  if (¿Está inactiva y puede reactivarse?) then (Sí)\n    :Preparar cambio a estado activo;\n  else (No)\n    :Informar por qué no puede reactivarse;\n    stop\n  endif\n\ncase (Eliminar)\n  |Base de datos|\n  :Consultar estado y dependencias;\n\n  |Sistema|\n  if (¿La entidad está inactiva?) then (Sí)\n    :Verificar dependencias que\\nimpiden la eliminación;\n    note right\n      Programa: fichas existentes.\n      Ficha: aprendices asociados.\n      Instructor: historial de asistencia\n      como responsable.\n      Aprendiz: asistencias registradas.\n    end note\n\n    if (¿Tiene dependencias protegidas?) then (Sí)\n      :Rechazar eliminación e indicar\\nla relación que la impide;\n      stop\n    else (No)\n      :Preparar eliminación permanente;\n    endif\n  else (No)\n    :Informar que debe desactivarse\\nantes de intentar eliminarla;\n    stop\n  endif\n\nendswitch\n\n|Sistema|\n:Mostrar resumen de la operación;\n\n|Coordinador|\n:Revisar y decidir confirmación;\n\n|Sistema|\nif (¿Confirma la operación?) then (Sí)\n  |Base de datos|\n  :Ejecutar cambio y registrar\\nfecha, hora y responsable;\n\n  |Sistema|\n  if (¿Operación guardada correctamente?) then (Sí)\n    :Mostrar confirmación y\\nactualizar listado;\n  else (No)\n    :Informar que no se guardó\\nla operación;\n  endif\nelse (No)\n  :Cancelar sin realizar cambios;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="gL1eUZMR8FJFV75dVDI5-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
