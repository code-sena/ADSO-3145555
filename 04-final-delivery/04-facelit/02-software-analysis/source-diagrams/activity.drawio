  <diagram id="fe5kVQY44qWfdiHVDT6g" name="RF-1.3 — Definición de rol al iniciar sesión">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n title RF-1.3 — Definición de rol al iniciar sesión\n caption Flujo objetivo del SRS V3 | Estado: PARCIAL\n skinparam shadowing false\n skinparam defaultFontName SansSerif\n skinparam defaultFontSize 13\n skinparam activityBackgroundColor #F4F7FB\n skinparam activityBorderColor #334155\n skinparam activityDiamondBackgroundColor #FFF4CE\n skinparam activityDiamondBorderColor #334155\n skinparam ArrowColor #334155\n skinparam swimlaneBorderColor #64748B\n|Sistema|\nstart\n:Recibir resultado de autenticación válida;\n|Base de datos|\n:Consultar rol previamente asignado\na la cuenta por el Coordinador;\n|Sistema|\nif (¿Rol reconocido?) then (Sí)\n if (¿Rol Aprendiz?) then (Sí)\n  :Definir alcance propio;\n else (No)\n  if (¿Rol Instructor?) then (Sí)\n   :Definir alcance de fichas asignadas;\n  else (Coordinador)\n   :Definir permisos administrativos;\n  endif\n endif\n :Incorporar rol y permisos a la sesión;\n :Construir menús y navegación por rol;\n :Validar permisos en backend\nen cada operación posterior;\n |Usuario|\n :Acceder al panel de su rol;\nelse (No)\n :No habilitar área protegida;\n |Base de datos|\n :Registrar error de cuenta sin rol\no rol no reconocido;\n |Sistema|\n :Mostrar error controlado;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Rh69XY1YXY8QxgzF4n0T-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Sistema" plantUmlId="lane_69" plantUmlBaseStyle="swimlane;collapsible=0;startSize=30;fillColor=none;swimlaneFillColor=none;strokeColor=#64748B;strokeWidth=1.5;fontColor=#000000;fontSize=13;fontStyle=0;html=1;shadow=0;fontFamily=SansSerif;" plantUmlBaseValue="Sistema" id="Rh69XY1YXY8QxgzF4n0T-2">
          <mxCell parent="Rh69XY1YXY8QxgzF4n0T-1" style="swimlane;collapsible=0;startSize=30;fillColor=none;swimlaneFillColor=none;strokeColor=#64748B;strokeWidth=1.5;fontColor=#000000;fontSize=13;fontStyle=0;html=1;shadow=0;fontFamily=SansSerif;" vertex="1">
            <mxGeometry height="721" width="749" x="30" y="64" as="geometry" />
          </mxCell>
