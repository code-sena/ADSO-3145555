  <diagram id="9NnkPlk8ck25YOaCGjQC" name="RF-5.4 — Resolver solicitud de registro del Aprendiz">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n title RF-5.4 — Resolver solicitud de registro del Aprendiz\n caption Flujo objetivo del SRS V3 | Estado: POR VERIFICAR\n skinparam shadowing false\n skinparam defaultFontName SansSerif\n skinparam defaultFontSize 13\n skinparam activityBackgroundColor #F4F7FB\n skinparam activityBorderColor #334155\n skinparam activityDiamondBackgroundColor #FFF4CE\n skinparam activityDiamondBorderColor #334155\n skinparam ArrowColor #334155\n skinparam swimlaneBorderColor #64748B\n|Aprendiz|\nstart\n:Solicitar nuevo registro facial;\n|Sistema|\n:Verificar registro previo, titularidad\ny ausencia de solicitud pendiente;\nif (¿Solicitud válida?) then (Sí)\n |Base de datos|\n :Guardar solicitud pendiente;\n |Sistema|\n :Notificar al Coordinador según RF-8.4;\n |Coordinador|\n :Aceptar o rechazar desde la notificación;\n |Sistema|\n :Revalidar permiso y solicitud pendiente;\n if (¿Puede resolverla?) then (Sí)\n  |Base de datos|\n  :Registrar decisión una sola vez\ncon actor y fecha;\n  |Sistema|\n  if (¿Aceptada?) then (Sí)\n   :Emitir autorización de un solo uso\nligada al Aprendiz;\n   |Aprendiz|\n   :Completar nuevo enrolamiento RF-5.1;\n   |Sistema|\n   if (¿Registro completado?) then (Sí)\n    |Base de datos|\n    :Consumir autorización;\n   else (No)\n    |Sistema|\n    :Aplicar vigencia y reglas de reintento;\n   endif\n  else (Rechazada)\n   :Mantener registro facial actual\ny permitir nueva solicitud;\n  endif\n  :Comunicar decisión al Aprendiz;\n else (No)\n  :Impedir decisión duplicada o no autorizada;\n endif\nelse (No)\n :Informar impedimento sin duplicar solicitud;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="w3JK4Q-4tEwj77ZGpL_b-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
