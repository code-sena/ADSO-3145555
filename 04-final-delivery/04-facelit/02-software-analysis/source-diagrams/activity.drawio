  <diagram id="p5yOHE-0eBmN-dTF7dOl" name="RF-8.4 — Notificación de solicitud de reconocimiento facial">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n title RF-8.4 — Notificación de solicitud de reconocimiento facial\n caption Flujo objetivo del SRS V3 | Estado: PENDIENTE / BRECHA\n skinparam shadowing false\n skinparam defaultFontName SansSerif\n skinparam defaultFontSize 13\n skinparam activityBackgroundColor #F4F7FB\n skinparam activityBorderColor #334155\n skinparam activityDiamondBackgroundColor #FFF4CE\n skinparam activityDiamondBorderColor #334155\n skinparam ArrowColor #334155\n skinparam swimlaneBorderColor #64748B\n|Aprendiz|\nstart\n:Solicitar registro facial nuevamente;\n|Sistema|\n:Validar solicitud propia y no duplicada;\nif (¿Solicitud válida?) then (Sí)\n |Base de datos|\n :Guardar solicitud y notificación pendiente;\n |Sistema|\n :Mostrar al Coordinador nombre, documento\ny botones Aceptar / Rechazar en el buzón;\n |Coordinador|\n :Resolver desde la misma notificación;\n |Sistema|\n :Revalidar autorización y estado pendiente;\n if (¿Puede resolver?) then (Sí)\n  if (¿Acepta?) then (Sí)\n   |Base de datos|\n   :Guardar aceptación, actor y fecha\ny autorización de un solo uso;\n   |Sistema|\n   :Habilitar nuevo registro facial del Aprendiz\nsegún RF-5.4 y RF-5.1;\n  else (Rechaza)\n   |Base de datos|\n   :Guardar rechazo, actor y fecha;\n   |Sistema|\n   :Mantener registro facial existente;\n  endif\n  :Comunicar decisión al Aprendiz;\n else (No)\n  :Impedir resolución repetida o no autorizada;\n endif\nelse (No)\n :Informar sin duplicar notificación;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CMaNsXoFbAUuRMuHKqnl-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
