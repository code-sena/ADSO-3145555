  <diagram id="7lapuHH73OjxD9uoR4by" name="RF-1.4 — Restablecimiento de contraseña">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n title RF-1.4 — Restablecimiento de contraseña\n caption Flujo objetivo del SRS V3 | Estado: PARCIAL\n skinparam shadowing false\n skinparam defaultFontName SansSerif\n skinparam defaultFontSize 13\n skinparam activityBackgroundColor #F4F7FB\n skinparam activityBorderColor #334155\n skinparam activityDiamondBackgroundColor #FFF4CE\n skinparam activityDiamondBorderColor #334155\n skinparam ArrowColor #334155\n skinparam swimlaneBorderColor #64748B\n|Usuario|\nstart\n:Solicitar recuperación e ingresar correo;\n|Sistema|\n:Validar solicitud;\n|Base de datos|\n:Localizar cuenta y correo registrado;\n|Sistema|\nif (¿Se puede continuar?) then (Sí)\n :Generar código único de un solo uso\ncon vencimiento máximo de 5 minutos;\n |Base de datos|\n :Registrar código y vencimiento;\n |Servicio de correo|\n :Enviar código al correo registrado;\n |Sistema|\n if (¿Envío exitoso?) then (Sí)\n  |Usuario|\n  :Ingresar código, nueva contraseña\ny confirmación;\n  |Sistema|\n  :Verificar código, vigencia y uso;\n  if (¿Código válido y no utilizado?) then (Sí)\n   :Validar política y confirmación;\n   if (¿Contraseña válida?) then (Sí)\n    :Calcular hash seguro;\n    |Base de datos|\n    :Reemplazar hash, invalidar código\ny auditar recuperación;\n    |Sistema|\n    :Confirmar; ofrecer inicio de sesión;\n   else (No)\n    :Señalar política incumplida\ny permitir corregir contraseña;\n   endif\n  else (No)\n   :Rechazar código; permitir solicitar otro;\n  endif\n else (No)\n  :Informar que no fue posible continuar;\n endif\nelse (No)\n :Informar que no fue posible continuar;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bK_do6BDEI9yg947a_dc-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Flujo objetivo del SRS V3 | Estado: PARCIAL" plantUmlId="caption_1" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=SansSerif;" plantUmlBaseValue="Flujo objetivo del SRS V3 | Estado: PARCIAL" id="bK_do6BDEI9yg947a_dc-62">
          <mxCell parent="bK_do6BDEI9yg947a_dc-1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=SansSerif;" vertex="1">
            <mxGeometry height="18" width="304" x="667.25" y="1186" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n title RF-2.1 — Carga institucional por archivo CSV\n caption Flujo objetivo del SRS V3 | Estado: PARCIAL\n skinparam shadowing false\n skinparam defaultFontName SansSerif\n skinparam defaultFontSize 13\n skinparam activityBackgroundColor #F4F7FB\n skinparam activityBorderColor #334155\n skinparam activityDiamondBackgroundColor #FFF4CE\n skinparam activityDiamondBorderColor #334155\n skinparam ArrowColor #334155\n skinparam swimlaneBorderColor #64748B\n|Coordinador|\nstart\n:Abrir carga institucional;\n|Sistema|\n:Validar sesión y permiso de Coordinador;\nif (¿Autorizado?) then (Sí)\n :Mostrar guía RF-2.1.1;\nelse (No)\n :Denegar carga;\n stop\nendif\n|Coordinador|\n:Seleccionar archivo CSV;\n|Sistema|\n:Validar extensión, lectura y encabezados;\nif (¿Archivo válido?) then (Sí)\n while (¿Quedan filas?) is (Sí)\n  :Leer fila y validar tipo, campos,\ncorreo y referencias requeridas;\n  if (¿Fila válida?) then (Sí)\n   if (¿Instructor transversal con programa?) then (Sí)\n    :Ignorar programa y registrar advertencia;\n   endif\n   |Base de datos|\n   :Buscar entidad y relaciones existentes;\n   |Sistema|\n   if (¿Cambia una relación ya asignada?) then (Sí)\n    :Bloquear inconsistencia; agregar enlace\nal registro para decisión manual;\n   else (No)\n    if (¿Cuenta nueva de aprendiz o instructor?) then (Sí)\n     :Generar credencial segura según RF-3.4;\n    endif\n    :Preparar creación o actualización;\n    :Acumular programas del instructor específico\nsin duplicar persona ni borrar asociaciones;\n    |Base de datos|\n    :Guardar fila válida y fechas;\n    |Sistema|\n    :Contabilizar resultado; registrar fallo\nsi la fila no pudo guardarse;\n   endif\n  else (No)\n   :Registrar error de fila sin procesarla;\n  endif\n endwhile (No)\n :Mostrar creadas, actualizadas,\ninconsistencias bloqueadas y errores;\n |Base de datos|\n :Registrar responsable y fecha de carga;\nelse (No)\n |Sistema|\n :Explicar errores de archivo sin procesarlo;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YkhBrMW8sWIz89Ae0b6q-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
