  <diagram id="dkCHaPDP8kJDzpX9PMSb" name="RF-5.1 — Registro inicial del Aprendiz">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n title RF-5.1 — Registro inicial del Aprendiz\n caption Flujo objetivo del SRS V3 | Estado: PENDIENTE / BRECHA\n skinparam shadowing false\n skinparam defaultFontName SansSerif\n skinparam defaultFontSize 13\n skinparam activityBackgroundColor #F4F7FB\n skinparam activityBorderColor #334155\n skinparam activityDiamondBackgroundColor #FFF4CE\n skinparam activityDiamondBorderColor #334155\n skinparam ArrowColor #334155\n skinparam swimlaneBorderColor #64748B\n|Aprendiz|\nstart\n:Iniciar registro facial autorizado;\n|Sistema|\n:Verificar identidad y autorización\nsegún flujo aprobado de enrolamiento;\nif (¿Puede continuar?) then (Sí)\n :Solicitar muestras requeridas;\n |Cámara o dispositivo|\n :Capturar muestras faciales;\n |Sistema|\n :Validar calidad y cantidad;\n if (¿Muestras válidas y suficientes?) then (Sí)\n  |Servicio facial|\n  :Procesar muestras y generar resultado;\n  |Sistema|\n  if (¿Procesamiento exitoso?) then (Sí)\n   |Base de datos|\n   :Asociar resultado biométrico al Aprendiz\nsegún política de protección aprobada;\n   |Sistema|\n   :Comunicar resultado del registro;\n  else (No)\n   :Detener y permitir reintento seguro;\n  endif\n else (No)\n  :Solicitar nueva captura segura;\n endif\nelse (No)\n :Detener enrolamiento e informar;\nendif\nnote right\n Flujo de referencia: falta integrar la versión\n aprobada del requisito del Aprendiz.\n Cámara, consentimiento, cantidad de muestras\n y retención deben confirmarse.\nend note\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="HszIyMiUP4Pp_hqMv_5k-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
