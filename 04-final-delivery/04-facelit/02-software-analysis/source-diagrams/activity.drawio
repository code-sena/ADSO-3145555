      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n title RF-7.2 — Consulta de asistencia por usuario\n caption Flujo objetivo del SRS V3 | Estado: PENDIENTE / BRECHA\n skinparam shadowing false\n skinparam defaultFontName SansSerif\n skinparam defaultFontSize 13\n skinparam activityBackgroundColor #F4F7FB\n skinparam activityBorderColor #334155\n skinparam activityDiamondBackgroundColor #FFF4CE\n skinparam activityDiamondBorderColor #334155\n skinparam ArrowColor #334155\n skinparam swimlaneBorderColor #64748B\n|Usuario autorizado|\nstart\n:Buscar Aprendiz por nombre o documento;\n|Sistema|\n:Validar sesión y alcance en servidor;\n|Base de datos|\n:Consultar Aprendiz permitido;\n|Sistema|\nif (¿Existe y pertenece al alcance?) then (Sí)\n |Usuario autorizado|\n :Seleccionar periodo;\n |Sistema|\n if (¿Periodo válido?) then (Sí)\n  |Base de datos|\n  :Consultar registros individuales;\n  |Sistema|\n  if (¿Hay registros?) then (Sí)\n   :Mostrar historial con estados y detalle;\n   note right\n    RF-7.2 contiene referencias antiguas a RF-6.1\n    y contradicción de color para puntual.\n    Se adopta RF-7.1: rojo, amarillo y verde;\n    detalle disponible para cualquier estado.\n   end note\n   |Usuario autorizado|\n   :Consultar día, hora disponible,\nambiente e Instructor;\n   :Solicitar exportación si la necesita;\n   |Sistema|\n   if (¿Exportación autorizada?) then (Sí)\n    :Revalidar alcance y generar Excel o CSV\nidentificando al Aprendiz;\n   endif\n  else (No)\n   :Mostrar tabla vacía y aviso;\n  endif\n else (No)\n  :Informar periodo inválido;\n endif\nelse (No)\n :Mostrar respuesta controlada\nsin revelar datos fuera del alcance;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="r9ZudJdgSAxP0j8_9_kk-58">
