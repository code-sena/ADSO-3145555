      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n title RF-3.2 — Consulta y gestión de usuarios\n caption Flujo objetivo del SRS V3 | Estado: PARCIAL\n skinparam shadowing false\n skinparam defaultFontName SansSerif\n skinparam defaultFontSize 13\n skinparam activityBackgroundColor #F4F7FB\n skinparam activityBorderColor #334155\n skinparam activityDiamondBackgroundColor #FFF4CE\n skinparam activityDiamondBorderColor #334155\n skinparam ArrowColor #334155\n skinparam swimlaneBorderColor #64748B\n|Coordinador|\nstart\n:Buscar por nombre, apellido,\ndocumento o correo;\n|Sistema|\n:Validar permiso de consulta;\n|Base de datos|\n:Consultar coincidencias permitidas;\n|Sistema|\nif (¿Permiso válido y hay coincidencias?) then (Sí)\n :Mostrar resultados;\n |Coordinador|\n :Seleccionar cuenta y acción;\n |Sistema|\n if (¿Solo consultar?) then (Sí)\n  :Mostrar detalle permitido;\n else (Gestionar)\n  :Validar permiso específico;\n  |Coordinador|\n  :Introducir cambios o confirmar\ndesactivación/eliminación;\n  |Sistema|\n  :Validar datos y reglas RF-3.6;\n  if (¿Operación válida y confirmada?) then (Sí)\n   |Base de datos|\n   :Guardar cambio y trazabilidad\nsin afectar historial protegido;\n   |Sistema|\n   :Mostrar resultado del guardado;\n  else (No)\n   :Rechazar o cancelar sin cambios;\n  endif\n endif\nelse (No)\n :Informar sin exponer datos ajenos;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="aZy0jbcnI-eV8jGX0rqN-1">
