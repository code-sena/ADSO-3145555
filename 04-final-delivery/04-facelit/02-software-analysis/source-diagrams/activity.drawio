  <diagram id="9aV1fyKpTWHM9t-ULaCr" name="RF-9.1 — Reportes por rol">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n title RF-9.1 — Reportes por rol\n caption Flujo objetivo del SRS V3 | Estado: PARCIAL\n skinparam shadowing false\n skinparam defaultFontName SansSerif\n skinparam defaultFontSize 13\n skinparam activityBackgroundColor #F4F7FB\n skinparam activityBorderColor #334155\n skinparam activityDiamondBackgroundColor #FFF4CE\n skinparam activityDiamondBorderColor #334155\n skinparam ArrowColor #334155\n skinparam swimlaneBorderColor #64748B\n|Usuario|\nstart\n:Abrir reportes;\n|Sistema|\n:Validar sesión y rol;\nif (¿Rol reconocido?) then (Sí)\n if (¿Coordinador?) then (Sí)\n  :Definir alcance institucional permitido;\n else (No)\n  if (¿Instructor?) then (Sí)\n   :Definir alcance de fichas asignadas;\n  else (Aprendiz)\n   :Definir únicamente reporte propio;\n  endif\n endif\n |Usuario|\n :Seleccionar reporte, filtros y periodo;\n |Sistema|\n :Validar filtros y alcance en servidor;\n if (¿Consulta autorizada y filtros válidos?) then (Sí)\n  |Base de datos|\n  :Consultar registros del alcance permitido;\n  |Sistema|\n  if (¿Fuente disponible y hay datos?) then (Sí)\n   :Calcular indicadores según fórmulas\ny denominadores aprobados;\n   :Mostrar reporte de solo lectura;\n   |Usuario|\n   :Elegir exportar si necesita archivo;\n   |Sistema|\n   if (¿Solicita exportar y está permitido?) then (Sí)\n    :Revalidar alcance y generar archivo;\n    |Base de datos|\n    :Registrar trazabilidad de exportación;\n   endif\n  else (No)\n   :Mostrar estado vacío o error de fuente;\n  endif\n else (No)\n  :Rechazar sin revelar datos ajenos;\n endif\nelse (No)\n :Denegar acceso;\nendif\nnote right\n Fórmulas, columnas, tiempos y formatos\n requieren definición en los criterios del SRS.\n Resumen grupal anónimo del Aprendiz solo\n si se aprueba explícitamente su alcance.\nend note\nstop\n@enduml\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5sX8LTCs17mDMu34eyld-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
