  <diagram id="caoQjbK--R49odF7B4RA" name="RF-3.6 — Estado del usuario">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n title RF-3.6 — Estado del usuario\n caption Flujo objetivo del SRS V3 | Estado: PARCIAL\n skinparam shadowing false\n skinparam defaultFontName SansSerif\n skinparam defaultFontSize 13\n skinparam activityBackgroundColor #F4F7FB\n skinparam activityBorderColor #334155\n skinparam activityDiamondBackgroundColor #FFF4CE\n skinparam activityDiamondBorderColor #334155\n skinparam ArrowColor #334155\n skinparam swimlaneBorderColor #64748B\n|Coordinador|\nstart\n:Consultar cuenta y elegir activar,\ndesactivar o eliminar;\n|Base de datos|\n:Consultar estado, relaciones e historial;\n|Sistema|\n:Validar autorización y transición;\nif (¿Operación permitida?) then (Sí)\n if (¿Eliminar?) then (Sí)\n  if (¿Eliminación física afecta historial?) then (Sí)\n   :Rechazar eliminación física,\nconservar cuenta e historial;\n   stop\n  else (No)\n   :Preparar eliminación permitida;\n  endif\n else (No)\n  :Preparar activación o desactivación;\n endif\n |Coordinador|\n :Confirmar cambio;\n |Sistema|\n if (¿Confirma?) then (Sí)\n  |Base de datos|\n  :Guardar estado y auditoría\npreservando relaciones históricas;\n  |Sistema|\n  if (¿Guardado exitoso?) then (Sí)\n   :Aplicar acceso según estado\ny confirmar resultado;\n  else (No)\n   :Conservar estado anterior e informar fallo;\n  endif\n else (No)\n  :Cancelar sin cambios;\n endif\nelse (No)\n :Informar impedimento y conservar estado;\nendif\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="w4SvLmvdh1NOZFBnff3l-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
