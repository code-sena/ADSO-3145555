        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!pragma layout smetana\nskinparam shadowing false\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 12\nskinparam classAttributeIconSize 0\nskinparam linetype polyline\nskinparam nodesep 70\nskinparam ranksep 90\nhide methods\nhide circle\ntitle FaceLit Modelo MER conceptual\nclass \&quot;Usuario\&quot; as T1 {\n  id_user_app &lt;&lt;identificador&gt;&gt;\n  first_name\n  last_name\n  account_status\n  number_document\n}\nclass \&quot;Credencial\&quot; as T2 {\n  id_credential &lt;&lt;identificador&gt;&gt;\n  email\n  password_hash\n  credential_status\n  failed_attempts\n  locked_until\n}\nclass \&quot;Recuperación de contraseña\&quot; as T3 {\n  id_password_recovery &lt;&lt;identificador&gt;&gt;\n  token\n  expiration_date\n  used\n}\nclass \&quot;Sesión de usuario\&quot; as T4 {\n  id_user_session &lt;&lt;identificador&gt;&gt;\n  start_date\n  end_date\n  session_status\n}\nclass \&quot;Configuración personal\&quot; as T5 {\n  id_user_configuration &lt;&lt;identificador&gt;&gt;\n  notifications_active\n  dark_mode\n  language\n}\nclass \&quot;Rol\&quot; as T6 {\n  id_role &lt;&lt;identificador&gt;&gt;\n  name_rol\n}\nclass \&quot;Permiso\&quot; as T7 {\n  id_permission &lt;&lt;identificador&gt;&gt;\n  name_permission\n  descripcion\n}\nclass \&quot;Asignación de rol\&quot; as T8 {\n  id_user_role &lt;&lt;identificador&gt;&gt;\n  asigned_at\n}\nclass \&quot;Asignación de permiso\&quot; as T9 {\n  id_role_permission &lt;&lt;identificador&gt;&gt;\n  assigned_at\n}\nclass \&quot;Programa\&quot; as T10 {\n  id_program &lt;&lt;identificador&gt;&gt;\n  program_name\n  program_code\n  state\n  deactivation_reason\n}\nclass \&quot;Instructor\&quot; as T11 {\n  id_instructor &lt;&lt;identificador&gt;&gt;\n  instructor_type\n}\nclass \&quot;Vínculo Instructor Programa\&quot; as T12 {\n  id_instructor_program &lt;&lt;identificador&gt;&gt;\n}\nclass \&quot;Historial de cambios\&quot; as T13 {\n  id_change_history &lt;&lt;identificador&gt;&gt;\n  entity_name\n  entity_id\n  field_name\n  old_value\n  new_value\n  action\n}\nclass \&quot;Ficha\&quot; as T14 {\n  id_chip &lt;&lt;identificador&gt;&gt;\n  chip_code\n  start_date\n  end_date\n  state\n  deactivation_reason\n}\nclass \&quot;Asignación Instructor Ficha\&quot; as T15 {\n  id_instructor_chip &lt;&lt;identificador&gt;&gt;\n  assignment_start\n  assignment_end\n  active\n}\nclass \&quot;Aprendiz\&quot; as T16 {\n  id_apprentice &lt;&lt;identificador&gt;&gt;\n}\nclass \&quot;Vinculación Aprendiz Ficha\&quot; as T17 {\n  id_apprentice_chip &lt;&lt;identificador&gt;&gt;\n  state\n}\nclass \&quot;Traslado pendiente CSV\&quot; as T18 {\n  id_pending_transfer &lt;&lt;identificador&gt;&gt;\n  source_row_number\n  status\n  resolved_at\n  resolved_by\n}\nclass \&quot;Ambiente\&quot; as T19 {\n  id_environment &lt;&lt;identificador&gt;&gt;\n  environment_name\n  capacity\n  state\n}\nclass \&quot;Asignación Ficha Ambiente\&quot; as T20 {\n  id_chip_environment &lt;&lt;identificador&gt;&gt;\n  assignment_date\n  state\n}\nclass \&quot;Sesión de reconocimiento\&quot; as T21 {\n  id_record_environment &lt;&lt;identificador&gt;&gt;\n  entry_time\n  registration_minutes\n  exit_time\n  shutdown_time\n  exit_reminder_sent\n  active\n}\nclass \&quot;Notificación\&quot; as T22 {\n  id_notification &lt;&lt;identificador&gt;&gt;\n  notification_type\n  category\n  title\n  message\n  channel\n  read_status\n  read_at\n  reference_entity\n  reference_id\n  metadata_json\n}\nclass \&quot;Registro de envío de correo\&quot; as T23 {\n  id_email_log &lt;&lt;identificador&gt;&gt;\n  send_status\n  attempts\n  sent_at\n}\nclass \&quot;Aceptación de términos\&quot; as T24 {\n  id_acceptance &lt;&lt;identificador&gt;&gt;\n  accepted\n}\nclass \&quot;Dispositivo\&quot; as T25 {\n  id_device &lt;&lt;identificador&gt;&gt;\n  device_code\n  location\n  status\n  origin_ip\n}\nclass \&quot;Perfil facial\&quot; as T26 {\n  id_user_face &lt;&lt;identificador&gt;&gt;\n  embedding\n  embedding_dimension\n  model_name\n  photo_reference\n  status\n}\nclass \&quot;Evento facial de asistencia\&quot; as T27 {\n  id_facial_event &lt;&lt;identificador&gt;&gt;\n  event_datetime\n  event_type\n  recognition_result\n  attendance_status\n  match_score\n  origin\n}\nclass \&quot;Bitácora biométrica\&quot; as T28 {\n  id_biometric_log &lt;&lt;identificador&gt;&gt;\n  description\n  log_date\n}\nclass \&quot;Solicitud de nuevo registro facial\&quot; as T29 {\n  id_face_reset_request &lt;&lt;identificador&gt;&gt;\n  request_status\n  requested_at\n  resolved_at\n}\nT1 \&quot;1\&quot; -- \&quot;0..*\&quot; T18 : usuario\nT14 \&quot;1\&quot; -- \&quot;0..*\&quot; T18 : ficha actual\nT14 \&quot;1\&quot; -- \&quot;0..*\&quot; T18 : ficha propuesta\nT1 \&quot;1\&quot; -- \&quot;0..*\&quot; T2 : usuario\nT1 \&quot;1\&quot; -- \&quot;0..*\&quot; T3 : usuario\nT1 \&quot;1\&quot; -- \&quot;0..*\&quot; T4 : usuario\nT1 \&quot;1\&quot; -- \&quot;0..1\&quot; T5 : usuario\nT1 \&quot;1\&quot; -- \&quot;0..*\&quot; T8 : usuario\nT6 \&quot;1\&quot; -- \&quot;0..*\&quot; T8 : rol\nT6 \&quot;1\&quot; -- \&quot;0..*\&quot; T9 : rol\nT7 \&quot;1\&quot; -- \&quot;0..*\&quot; T9 : permiso\nT1 \&quot;1\&quot; -- \&quot;0..1\&quot; T11 : usuario\nT11 \&quot;1\&quot; -- \&quot;0..*\&quot; T12 : id_instructor\nT10 \&quot;1\&quot; -- \&quot;0..*\&quot; T12 : programa\nT10 \&quot;1\&quot; -- \&quot;0..*\&quot; T14 : programa\nT11 \&quot;1\&quot; -- \&quot;0..*\&quot; T15 : id_instructor\nT14 \&quot;1\&quot; -- \&quot;0..*\&quot; T15 : ficha\nT1 \&quot;1\&quot; -- \&quot;0..1\&quot; T16 : usuario\nT16 \&quot;1\&quot; -- \&quot;0..*\&quot; T17 : Aprendiz\nT14 \&quot;1\&quot; -- \&quot;0..*\&quot; T17 : ficha\nT14 \&quot;1\&quot; -- \&quot;0..*\&quot; T20 : ficha\nT19 \&quot;1\&quot; -- \&quot;0..*\&quot; T20 : ambiente\nT19 \&quot;1\&quot; -- \&quot;0..*\&quot; T21 : ambiente\nT14 \&quot;1\&quot; -- \&quot;0..*\&quot; T21 : ficha\nT11 \&quot;0..1\&quot; -- \&quot;0..*\&quot; T21 : Instructor a cargo\nT1 \&quot;1\&quot; -- \&quot;0..*\&quot; T22 : usuario\nT27 \&quot;0..1\&quot; -- \&quot;0..*\&quot; T22 : evento\nT22 \&quot;1\&quot; -- \&quot;0..1\&quot; T23 : id_notification\nT1 \&quot;1\&quot; -- \&quot;0..*\&quot; T24 : usuario\nT19 \&quot;1\&quot; -- \&quot;0..*\&quot; T25 : ambiente\nT25 \&quot;1\&quot; -- \&quot;0..*\&quot; T21 : dispositivo\nT16 \&quot;1\&quot; -- \&quot;0..1\&quot; T26 : Aprendiz\nT21 \&quot;1\&quot; -- \&quot;0..*\&quot; T27 : sesión\nT25 \&quot;1\&quot; -- \&quot;0..*\&quot; T27 : dispositivo\nT16 \&quot;1\&quot; -- \&quot;0..*\&quot; T27 : Aprendiz\nT1 \&quot;1\&quot; -- \&quot;0..*\&quot; T29 : usuario\nT1 \&quot;0..1\&quot; -- \&quot;0..*\&quot; T29 : resuelve\nT27 \&quot;1\&quot; -- \&quot;0..*\&quot; T28 : evento\nT11 \&quot;1\&quot; .. \&quot;0..*\&quot; T21 : Instructor programado (inferida)\nlegend bottom\nMER conceptual derivado del SQL, con entidades asociativas explícitas.\nSe omiten columnas de auditoría y FK para destacar conceptos y atributos.\n1 = uno | 0..1 = opcional único | 0..* = cero o muchos.\nLínea punteada = relación inferida de Instructor programado, sin FK.\nendlegend\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QoAp4V_RFdsCvsd6btZs-261">
