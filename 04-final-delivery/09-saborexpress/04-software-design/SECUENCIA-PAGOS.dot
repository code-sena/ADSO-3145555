digraph G {graph [rankdir=LR, bgcolor="white",ranksep=.65,nodesep=.5];node[shape=box,style="rounded,filled",fillcolor="#E7F1FC",fontname="DejaVu Sans",color="#51708C"];edge[fontname="DejaVu Sans",fontsize=10,color="#516987"];C[label="1. Cliente / caja\nInicia pago"];API[label="2. API Payments\nCrea referencia"];W[label="3. Wompi\nProcesa en sandbox"];H[label="4. Webhook API\nRecibe evento"];V[label="5. Servicio de pago\nVerifica firma + referencia\ny duplicados (a comprobar)"];DB[label="6. Persistencia\nActualiza estado"];C->API->W->H->V->DB;}