digraph G {graph[bgcolor="white",rankdir=LR,pad=.3,label="Figura 3. Estados generales del pedido (propuesta para contrastar con enums)",labelloc=b,fontname="Arial"];node[fontname="Arial",shape=box,style="rounded,filled",fillcolor="#f8fbff"];edge[fontname="Arial"];A[label="Selección\nde catálogo"];B[label="Solicitud\nde pedido"];C[label="Pending\n(en código)",fillcolor="#fff1c7"];D[label="Confirmed\n(en controlador)",fillcolor="#dff2e4"];E[label="Preparación /\nentrega",fillcolor="#ebefff"];F[label="Cancelación\ncontrolada",fillcolor="#ffe1e1"];A->B->C->D->E;C->F[label="si permitido"];D->F[style=dashed,label="según regla de negocio"]; }