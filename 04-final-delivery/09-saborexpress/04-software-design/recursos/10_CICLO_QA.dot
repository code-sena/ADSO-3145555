digraph G {graph[bgcolor="white",rankdir=LR,pad=.3,label="Figura 10. Ciclo de validación recomendado; pruebas no ejecutadas",labelloc=b,fontname="Arial"];node[fontname="Arial",shape=box,style="rounded,filled",fillcolor="#f8fafc"];edge[fontname="Arial"];A[label="Requisito RF / RNF"];B[label="Caso de prueba + datos sintéticos"];C[label="Ejecución versionada"];D[label="Evidencia y resultado"];E[label="Incidencia y corrección"];F[label="Aprobación y trazabilidad"];A->B->C->D->F;D->E[label="si falla"];E->C[label="regresión"]; }