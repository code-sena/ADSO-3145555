digraph G {graph[bgcolor="white",pad=.3,label="Figura 9. Controles de autorización que deben validarse",labelloc=b,fontname="Arial"];node[fontname="Arial",shape=box,style="rounded,filled",fillcolor="#f8fbff"];edge[fontname="Arial"];A[label="Solicitud JWT"];B[label="Token válido?",shape=diamond,fillcolor="#fff0cc"];C[label="Rol o permiso?",shape=diamond,fillcolor="#fff0cc"];D[label="Sede / dueño / turno?",shape=diamond,fillcolor="#fff0cc"];E[label="Operación permitida",fillcolor="#ddf2df"];F[label="401 / 403",fillcolor="#ffe4e4"];A->B;B->C[label="sí"];B->F[label="no"];C->D[label="sí"];C->F[label="no"];D->E[label="sí"];D->F[label="no"]; }