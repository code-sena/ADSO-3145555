digraph G {graph[bgcolor="white",rankdir=LR,pad=.3,label="Figura 8. Casos de uso por actor",labelloc=b,fontname="Arial"];node[fontname="Arial",shape=box,style="rounded,filled",fillcolor="#fbfcff"];edge[fontname="Arial"];Cliente[label="CLIENTE",fillcolor="#dff0ff"];Cajero[label="CAJERO",fillcolor="#dff0ff"];Cocina[label="COCINERO",fillcolor="#dff0ff"];Reparto[label="REPARTIDOR",fillcolor="#dff0ff"];Gerente[label="GERENTE/ADMIN",fillcolor="#dff0ff"];UC1[label="Consultar catálogo\ny crear pedido"];UC2[label="Iniciar pago Wompi\ny cancelar propio"];UC3[label="Cobrar y consultar turno"];UC4[label="Gestionar preparación"];UC5[label="Actualizar estado entrega\ny calificar reparto"];UC6[label="Administrar productos, sedes,\nempleados y permisos"];Cliente->UC1;Cliente->UC2;Cajero->UC3;Cocina->UC4;Reparto->UC5;Gerente->UC6;}