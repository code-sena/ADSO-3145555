digraph G {graph[bgcolor="white",pad=.3,ranksep=.7,label="Figura 2. Componentes y responsabilidades",labelloc=b,fontname="Arial",fontsize=16];node[fontname="Arial",shape=box,style="rounded,filled",color="#28415b",fillcolor="#f4f8ff"];edge[fontname="Arial"];subgraph cluster_clients {label="Presentación"; color="#bbcee1";Next[label="Next.js 16 / React 19"];Expo[label="Expo 57 / React Native"]; } subgraph cluster_api {label="Backend modular .NET 8";color="#d8a4aa";Controllers[label="Controllers (rutas y validación HTTP)",fillcolor="#fff0f0"];Services[label="Módulos / Services / DTO / Validators"];Repository[label="Repositories + DbContext"];Realtime[label="SignalR / BackgroundServices"];Controllers->Services;Services->Repository;Services->Realtime[style=dashed];}Persistence[label="MySQL / PostgreSQL / SQL Server\nselección por configuración",shape=cylinder,fillcolor="#edf6e7"];Payments[label="Wompi",fillcolor="#fff3db"];Next->Controllers;Expo->Controllers;Expo->Realtime[style=dashed,label="eventos"];Repository->Persistence;Services->Payments; }