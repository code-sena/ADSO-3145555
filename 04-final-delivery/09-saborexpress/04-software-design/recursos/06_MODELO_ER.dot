digraph G {graph[bgcolor="white",pad=.3,ranksep=.8,label="Figura 6. Modelo relacional conceptual extraído de modelos C#",labelloc=b,fontname="Arial",fontsize=16];node[fontname="Arial",shape=record,style=filled,fillcolor="#f8fafc",color="#34445c"];edge[fontname="Arial",arrowhead=vee];User[label="{User|Id PK|Email|PasswordHash|Status}"];Employee[label="{Employee|Id PK|UserId FK|BranchId FK|IsAvailable}"];Branch[label="{Branch|Id PK|Name|Latitude|Longitude}"];Product[label="{Product|Id PK|CategoryId FK|BranchId FK|Price}"];Order[label="{Order|Id PK|BranchId FK|CustomerId FK|AddressId FK|Total|Status}"];Detail[label="{OrderDetail|Id PK|OrderId FK|ProductId FK|Quantity|UnitPrice}"];Payment[label="{Payment|Id PK|OrderId FK|Method|WompiReference}"];Delivery[label="{Delivery|Id PK|OrderId FK|DeliveryPersonId FK|Status}"];User->Employee;Branch->Employee;Branch->Product;Branch->Order;Order->Detail;Product->Detail;Order->Payment;Order->Delivery;Employee->Delivery;}